{
  "name": "floor-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-assets.mjs",
    "dev": "vite --host 127.0.0.1 --port 4178 --strictPort",
    "build": "node scripts/prepare-assets.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4178 --strictPort",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:stairs": "node tests/stairs.mjs"
  },
  "dependencies": {
    "clipper-lib": "6.4.2",
    "dxf-parser": "1.1.2",
    "pdfjs-dist": "6.4.299",
    "three": "0.185.0"
  },
  "devDependencies": {
    "playwright": "1.58.2",
    "vite": "7.3.6"
  }
}
